# Environment Configuration Template
PORT=5000
FLASK_ENV=development
DEBUG=True

# Security
JWT_SECRET_KEY=change_this_to_a_secure_random_64_character_string_in_production
JWT_EXPIRATION_HOURS=24

# External Translation Service
# Primary LibreTranslate instance (requires API key at libretranslate.com).
# If both LibreTranslate endpoints fail, the service falls back to MyMemory.
LIBRETRANSLATE_URL=https://libretranslate.com/translate
LIBRETRANSLATE_BACKUP_URL=
LIBRETRANSLATE_API_KEY=

# Database Settings
DATABASE_PATH=database/database.db

# CORS Allowed Origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
