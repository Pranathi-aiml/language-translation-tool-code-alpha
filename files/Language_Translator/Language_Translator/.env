# LibreTranslate configuration
# Free public mirror (rate limited). For production/reliable use,
# self-host LibreTranslate and change this URL.
LIBRETRANSLATE_URL=https://libretranslate.de/translate

# Leave blank for free public servers that don't require a key.
# If you self-host or use a paid mirror that requires a key, set it here.
LIBRETRANSLATE_API_KEY=
